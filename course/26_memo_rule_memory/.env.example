# 只填写在当前 shell 或私有环境文件中；不要把真实密钥提交到 Git。
DASHSCOPE_API_KEY=请填写你自己的密钥

# 阿里云百炼兼容模式示例；具体模型名和地址以购买服务的控制台为准。
MEMORY_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EXECUTIVE_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEMORY_API_MODEL=你部署的规则Memory模型名
EXECUTIVE_API_MODEL=你购买的推理模型名
